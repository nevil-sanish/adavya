# Firebase web configuration (same project as the captain website; public values)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Trusted game API (apps/api). Must be HTTPS when phones connect over the network.
VITE_API_URL=http://localhost:5000
# Must match the API's ALLOWED_EMAIL_DOMAIN
VITE_ALLOWED_EMAIL_DOMAIN=iiitkottayam.ac.in
# Optional: self-hosted MediaPipe pose model (defaults to Google's CDN)
# VITE_POSE_MODEL_URL=/mediapipe/pose_landmarker_lite.task
# Set to true to use `firebase emulators:start` (Auth 9099, Firestore 8080)
VITE_USE_EMULATORS=false
