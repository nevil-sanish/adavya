PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Configuration
FIREBASE_PROJECT_ID=adavya-f796d
# Required for Admin Firestore writes unless using serviceAccountKey.json or ADC.
# Both values must belong to the project above; use \n for private-key newlines.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mobile web app origin (HTTPS in deployment)
MOBILE_URL=http://localhost:5174

# Game
# Competition that new teams join; created by `npm run setup`.
COMPETITION_ID=main
# Only verified Google accounts at this domain may sign in (also hard-coded in firebase/firestore.rules).
ALLOWED_EMAIL_DOMAIN=iiitkottayam.ac.in
# Comma-separated admin emails for /api/admin and the website /admin page.
ADMIN_EMAILS=
# A member whose presence heartbeat is older than this counts as disconnected (ms).
PRESENCE_STALE_MS=45000

# Local emulators: uncomment to run the API against `firebase emulators:start`.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
