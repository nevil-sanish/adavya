{
  "name": "adavya-backend",
  "version": "1.0.0",
  "description": "Trusted game API for the Team Challenge Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "setup": "npm run build && node dist/scripts/setup-competition.js",
    "reset": "npm run build && node dist/scripts/reset-competition.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:emulator": "npm --prefix ../../firebase exec -- firebase emulators:exec --only firestore --project demo-adavya --config ../../firebase.json \"npm test\"",
    "rehearsal": "npm run build && node dist/scripts/rehearsal.js"
  },
  "keywords": [
    "adavya",
    "agentic",
    "workspace",
    "express",
    "firebase"
  ],
  "author": "Adavya Team",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
