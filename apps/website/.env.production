# Production build settings (public values only). Overrides .env for `npm run build`.
# /api is served on the same origin: the host (Render or Firebase Hosting) forwards it to the API.
VITE_API_URL=
VITE_USE_EMULATORS=false
# VITE_PLAYER_APP_URL is set by the host (render.yaml, or the deploy:web script for Firebase Hosting).
