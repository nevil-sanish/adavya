# Adavya — single environment file for every app.
# Copy to .env (repo root) and fill in. The API and scripts read every key;
# Vite exposes only VITE_* keys to the browser builds, so server secrets never ship to clients.
# Hosts (Render, Cloud Run) set these in their dashboard instead of using a file.

# ---------------------------------------------------------------- API (apps/api)
PORT=5000
NODE_ENV=development
# Allowed browser origins (CORS) when not going through the dev proxy / host rewrite
FRONTEND_URL=http://localhost:5173
MOBILE_URL=http://localhost:5174
# Firebase Admin: Firebase console → Project settings → Service accounts → Generate new private key.
# Use \n for line breaks in the key. Never commit the key.
FIREBASE_PROJECT_ID=adavya-f796d
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Competition that new teams join; created by `npm run setup` in apps/api
COMPETITION_ID=main
# Only verified Google accounts at this domain may sign in (also hard-coded in firebase/firestore.rules)
ALLOWED_EMAIL_DOMAIN=iiitkottayam.ac.in
# Comma-separated institute emails allowed to use /admin
ADMIN_EMAILS=
# A member whose presence heartbeat is older than this counts as disconnected (ms)
PRESENCE_STALE_MS=45000
# Local emulators: uncomment to run the API against `npm run emulators`
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ------------------------------------------- Browser apps (apps/website, apps/mobile)
# Firebase web config (public values): Project settings → General → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=adavya-f796d.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=adavya-f796d
VITE_FIREBASE_STORAGE_BUCKET=adavya-f796d.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Must match ALLOWED_EMAIL_DOMAIN
VITE_ALLOWED_EMAIL_DOMAIN=iiitkottayam.ac.in
# Empty: the dev servers proxy /api to http://localhost:$PORT (override with API_PROXY_TARGET)
VITE_API_URL=
# Player app URL shown on the captain site
VITE_PLAYER_APP_URL=http://localhost:5174
# true: use `npm run emulators` (Auth 9099, Firestore 8080) instead of the real project
VITE_USE_EMULATORS=false
# Optional: self-hosted MediaPipe pose model (defaults to Google's CDN)
# VITE_POSE_MODEL_URL=/mediapipe/pose_landmarker_lite.task
