# Production build switches for the browser apps (public values only; committed).
# Overrides .env for `npm run build`. /api is served on the same origin: the host
# (Render or Firebase Hosting) forwards it to the API.
# VITE_PLAYER_APP_URL is set by the host (render.yaml, or the deploy:web script for Firebase Hosting).
VITE_API_URL=
VITE_USE_EMULATORS=false
